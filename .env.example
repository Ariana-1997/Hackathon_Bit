# Copia este archivo como .env (NO lo subas a Git) o define las variables en tu IDE / plataforma.
SPRING_PROFILES_ACTIVE=dev

# Supabase -> Project Settings -> Database -> Connect -> JDBC (Session pooler)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<password-de-la-bd>
DB_POOL_MAX=10

# Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-o-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-o-secret-key>
# Solo si tu proyecto sigue usando el JWT secret heredado (HS256). Si usa "JWT Signing Keys", déjalo vacío.
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET=publicaciones

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
